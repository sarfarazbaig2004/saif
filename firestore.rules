rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function rootUserDoc(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function userDoc(companyId, userId) {
      return /databases/$(database)/documents/companies/$(companyId)/users/$(userId);
    }

    function hasRootUserProfile() {
      return signedIn() && exists(rootUserDoc(uid()));
    }

    function rootUserProfile() {
      return get(rootUserDoc(uid())).data;
    }

    function belongsToCompany(companyId) {
      return hasRootUserProfile() &&
        rootUserProfile().isActive == true &&
        rootUserProfile().companyId == companyId;
    }

    function hasUserProfile(companyId) {
      return signedIn() && exists(userDoc(companyId, uid()));
    }

    function userProfile(companyId) {
      return get(userDoc(companyId, uid())).data;
    }

    function isActive(companyId) {
      return belongsToCompany(companyId) ||
        (
          hasUserProfile(companyId) &&
          userProfile(companyId).isActive == true
        );
    }

    function role(companyId) {
      return belongsToCompany(companyId)
        ? rootUserProfile().role
        : (
            hasUserProfile(companyId) && userProfile(companyId).isActive == true
              ? userProfile(companyId).role
              : ''
          );
    }

    function isAdmin(companyId) {
      return role(companyId) in [
        'admin',
        'SOFTWARE_SUPER_ADMIN',
        'COMPANY_SUPER_ADMIN'
      ];
    }

    function isManager(companyId) {
      return role(companyId) in [
        'manager',
        'MANAGER'
      ];
    }

    function canReadCompany(companyId) {
      return isActive(companyId);
    }

    function canWriteCompany(companyId) {
      return isAdmin(companyId) || isManager(companyId);
    }

    function canDeleteCompany(companyId) {
      return isAdmin(companyId);
    }

    function companyFieldsMatchPath(companyId) {
      return !('companyId' in request.resource.data) ||
        request.resource.data.companyId == companyId;
    }

    function tenantFieldsMatchPath(companyId) {
      return !('tenantId' in request.resource.data) ||
        request.resource.data.tenantId == companyId;
    }

    function fieldsMatchPath(companyId) {
      return companyFieldsMatchPath(companyId) &&
        tenantFieldsMatchPath(companyId);
    }

    match /users/{userId} {
      allow read: if signedIn() && uid() == userId;
      allow create, update: if signedIn() && uid() == userId;
      allow delete: if false;
    }

    match /companies/{companyId} {
      allow read: if canReadCompany(companyId);
      allow create, update: if canWriteCompany(companyId) && fieldsMatchPath(companyId);
      allow delete: if false;

      match /users/{userId} {
        allow read: if canReadCompany(companyId);
        allow create, update: if canWriteCompany(companyId) && fieldsMatchPath(companyId);
        allow delete: if canDeleteCompany(companyId);
      }

      // Any authenticated active company user may read the CRM customer list.
      // This is intentionally broader than write (admin/manager only) so that
      // modules like Customer PO can populate selectors without requiring admin role.
      match /customers/{customerId} {
        allow read: if isActive(companyId);
        allow create, update: if canWriteCompany(companyId) && fieldsMatchPath(companyId);
        allow delete: if canDeleteCompany(companyId);
      }

      match /{document=**} {
        allow read: if canReadCompany(companyId);
        allow create, update: if canWriteCompany(companyId) && fieldsMatchPath(companyId);
        allow delete: if canDeleteCompany(companyId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}