rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function amanTenantId() {
      return 'aman_infra';
    }

    function softwareSuperAdminEmail() {
      return 'genzprotech@gmail.com';
    }

    function companySuperAdminEmail() {
      return 'shawej.s@amaninfradeveloper.co.in';
    }

    function isAmanTenant(tenantId) {
      return tenantId == amanTenantId();
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function isSoftwareSuperAdminAuth() {
      return signedIn() && authEmail() == softwareSuperAdminEmail();
    }

    function rootUserPath() {
      return /databases/$(database)/documents/users/$(uid());
    }

    function hasRootUserProfile() {
      return signedIn() && exists(rootUserPath());
    }

    function rootUser() {
      return get(rootUserPath()).data;
    }

    function rootUserAllowsAman() {
      return hasRootUserProfile() && (
        rootUser().tenantId == amanTenantId() ||
        rootUser().companyId == amanTenantId() ||
        rootUser().primaryTenantId == amanTenantId() ||
        rootUser().primaryCompanyId == amanTenantId()
      );
    }

    function companyUserPath(tenantId, userId) {
      return /databases/$(database)/documents/companies/$(tenantId)/users/$(userId);
    }

    function hasAmanMembership() {
      return signedIn() &&
        exists(companyUserPath(amanTenantId(), uid()));
    }

    function currentCompanyRole(tenantId) {
      return exists(companyUserPath(tenantId, uid()))
        ? get(companyUserPath(tenantId, uid())).data.role
        : '';
    }

    function isCompanySuperAdmin(tenantId) {
      return signedIn() &&
        isAmanTenant(tenantId) &&
        (
          currentCompanyRole(tenantId) == 'company_super_admin' ||
          authEmail() == companySuperAdminEmail()
        );
    }

    function isSoftwareSuperAdminMember(tenantId) {
      return signedIn() &&
        isAmanTenant(tenantId) &&
        (
          isSoftwareSuperAdminAuth() ||
          currentCompanyRole(tenantId) == 'software_super_admin'
        );
    }

    function isCompanyUserAdmin(tenantId) {
      return isSoftwareSuperAdminMember(tenantId) || isCompanySuperAdmin(tenantId);
    }

    function isComplianceAdmin(tenantId) {
      return isSoftwareSuperAdminMember(tenantId) || isCompanySuperAdmin(tenantId);
    }

    function isFinanceRole(tenantId) {
      return currentCompanyRole(tenantId) == 'finance';
    }

    function isHrRole(tenantId) {
      return currentCompanyRole(tenantId) == 'hr' ||
        currentCompanyRole(tenantId) == 'HR';
    }

    function isProductionQaRole(tenantId) {
      return currentCompanyRole(tenantId) == 'production' ||
        currentCompanyRole(tenantId) == 'qa' ||
        currentCompanyRole(tenantId) == 'QA';
    }

    function canAccessComplianceCategory(tenantId, category) {
      return canAccessAman(tenantId) &&
        (
          isComplianceAdmin(tenantId) ||
          (isFinanceRole(tenantId) && category == 'financial') ||
          (isHrRole(tenantId) && category == 'hr') ||
          (isProductionQaRole(tenantId) && category == 'quality')
        );
    }

    function canReadComplianceAccessCategories(tenantId, categories) {
      return canAccessAman(tenantId) &&
        (
          isComplianceAdmin(tenantId) ||
          (isFinanceRole(tenantId) && categories.hasAny(['financial'])) ||
          (isHrRole(tenantId) && categories.hasAny(['hr'])) ||
          (isProductionQaRole(tenantId) && categories.hasAny(['quality']))
        );
    }

    function canWriteComplianceAccessCategories(tenantId, categories) {
      return canAccessAman(tenantId) &&
        (
          isComplianceAdmin(tenantId) ||
          (isFinanceRole(tenantId) && categories.hasOnly(['financial'])) ||
          (isHrRole(tenantId) && categories.hasOnly(['hr'])) ||
          (isProductionQaRole(tenantId) && categories.hasOnly(['quality']))
        );
    }

    function hasComplianceAccessCategories(data) {
      return 'accessCategories' in data && data.accessCategories is list;
    }

    function canReadComplianceDocument(tenantId, data) {
      return hasComplianceAccessCategories(data)
        ? canReadComplianceAccessCategories(tenantId, data.accessCategories)
        : canAccessComplianceCategory(tenantId, data.category);
    }

    function canWriteComplianceDocument(tenantId, data) {
      return hasComplianceAccessCategories(data) &&
        canWriteComplianceAccessCategories(tenantId, data.accessCategories);
    }

    function validComplianceTags(data) {
      return 'documentCategories' in data &&
        data.documentCategories is list &&
        data.documentCategories.size() > 0 &&
        data.documentCategories.hasOnly([
          'gst',
          'pan',
          'aadhaar',
          'pf',
          'esic',
          'msme',
          'factory_license',
          'iso',
          'first_aid',
          'audit_report',
          'balance_sheet',
          'incoming_material_inspection',
          'in_process_inspection',
          'final_inspection',
          'galvanizing_inspection',
          'dispatch_clearance',
          'client_inspection_report',
        ]);
    }

    function validComplianceAccessCategories(data) {
      return hasComplianceAccessCategories(data) &&
        data.accessCategories.size() > 0 &&
        data.accessCategories.hasOnly(['financial', 'hr', 'quality', 'legal']);
    }

    function canAccessAman(tenantId) {
      return signedIn() &&
        isAmanTenant(tenantId) &&
        (
          isSoftwareSuperAdminAuth() ||
          isCompanySuperAdmin(tenantId) ||
          rootUserAllowsAman() ||
          hasAmanMembership()
        );
    }

    function isSoftwareSuperAdminData(data) {
      return data.role == 'software_super_admin' ||
        data.email == softwareSuperAdminEmail();
    }

    function isIncomingSoftwareSuperAdmin() {
      return isSoftwareSuperAdminData(request.resource.data);
    }

    function isExistingSoftwareSuperAdmin() {
      return isSoftwareSuperAdminData(resource.data);
    }

    function canCreateCompanyUser(tenantId) {
      return canAccessAman(tenantId) &&
        isCompanyUserAdmin(tenantId) &&
        (isSoftwareSuperAdminAuth() || !isIncomingSoftwareSuperAdmin());
    }

    function canUpdateCompanyUser(tenantId) {
      return canAccessAman(tenantId) &&
        isCompanyUserAdmin(tenantId) &&
        (
          isSoftwareSuperAdminAuth() ||
          (!isExistingSoftwareSuperAdmin() && !isIncomingSoftwareSuperAdmin())
        );
    }

    function tenantFieldsMatchPath(tenantId) {
      return !('tenantId' in request.resource.data) ||
        request.resource.data.tenantId == tenantId;
    }

    function companyFieldsMatchPath(tenantId) {
      return !('companyId' in request.resource.data) ||
        request.resource.data.companyId == tenantId;
    }

    function tenantWriteAllowed(tenantId) {
      return tenantFieldsMatchPath(tenantId) && companyFieldsMatchPath(tenantId);
    }

    function noRootTenantGrantFields() {
      return !('allowedTenantIds' in request.resource.data) &&
        !('companyIds' in request.resource.data) &&
        !('memberships' in request.resource.data) &&
        tenantFieldsMatchPath(amanTenantId()) &&
        companyFieldsMatchPath(amanTenantId());
    }

    function rootTenantGrantFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'allowedTenantIds',
        'companyIds',
        'memberships',
      ]) &&
      tenantFieldsMatchPath(amanTenantId()) &&
      companyFieldsMatchPath(amanTenantId());
    }

    function isIncomingRootSoftwareSuperAdmin() {
      return isSoftwareSuperAdminData(request.resource.data);
    }

    function isExistingRootSoftwareSuperAdmin() {
      return isSoftwareSuperAdminData(resource.data);
    }

    function canCreateRootAmanUser() {
      return isSoftwareSuperAdminAuth() ||
        (
          isCompanySuperAdmin(amanTenantId()) &&
          !isIncomingRootSoftwareSuperAdmin()
        );
    }

    function canUpdateRootAmanUser() {
      return isSoftwareSuperAdminAuth() ||
        (
          isCompanySuperAdmin(amanTenantId()) &&
          !isExistingRootSoftwareSuperAdmin() &&
          !isIncomingRootSoftwareSuperAdmin()
        );
    }

    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isCompanyUserAdmin(amanTenantId()));
      allow create: if (signedIn() && uid() == userId && noRootTenantGrantFields()) ||
        canCreateRootAmanUser();
      allow update: if (signedIn() && uid() == userId && rootTenantGrantFieldsUnchanged()) ||
        canUpdateRootAmanUser();
      allow delete: if false;
    }

    match /companies/{tenantId} {
      allow read: if canAccessAman(tenantId);
      allow create, update: if canAccessAman(tenantId) && tenantWriteAllowed(tenantId);
      allow delete: if false;

      match /users/{userId} {
        allow read: if canAccessAman(tenantId);
        allow create: if canCreateCompanyUser(tenantId) && tenantWriteAllowed(tenantId);
        allow update: if canUpdateCompanyUser(tenantId) && tenantWriteAllowed(tenantId);
        allow delete: if false;
      }

      match /compliance_documents/{documentId} {
        allow read: if canReadComplianceDocument(tenantId, resource.data);
        allow create: if canWriteComplianceDocument(tenantId, request.resource.data) &&
          tenantWriteAllowed(tenantId) &&
          validComplianceTags(request.resource.data) &&
          validComplianceAccessCategories(request.resource.data);
        allow update: if canReadComplianceDocument(tenantId, resource.data) &&
          canWriteComplianceDocument(tenantId, request.resource.data) &&
          tenantWriteAllowed(tenantId) &&
          validComplianceTags(request.resource.data) &&
          validComplianceAccessCategories(request.resource.data);
        allow delete: if canAccessAman(tenantId) &&
          isComplianceAdmin(tenantId) &&
          resource.data.isQmsDocument != true;
      }

      match /{document=**} {
        allow read: if canAccessAman(tenantId);
        allow create, update: if canAccessAman(tenantId) && tenantWriteAllowed(tenantId);
        allow delete: if canAccessAman(tenantId) && isSoftwareSuperAdminAuth();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
